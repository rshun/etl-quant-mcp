{
  "adjust": {
    "program": "adjust",
    "module": "etl.adjust",
    "description": "A股复权因子入库 (支持多源、多代码)",
    "arguments": {
      "begin": {
        "flags": [
          "-b",
          "--begin"
        ],
        "type": "str",
        "action": "store",
        "nargs": null,
        "default": "<TODAY>",
        "choices": null,
        "required": false,
        "help": "指定交易日期 (格式: YYYYMMDD)，默认为当天"
      },
      "end": {
        "flags": [
          "-e",
          "--end"
        ],
        "type": "str",
        "action": "store",
        "nargs": null,
        "default": "<TODAY>",
        "choices": null,
        "required": false,
        "help": "截止日期 (格式: YYYYMMDD),默认当天"
      },
      "codes": {
        "flags": [
          "-c",
          "--codes"
        ],
        "type": null,
        "action": "store",
        "nargs": "+",
        "default": null,
        "choices": null,
        "required": false,
        "help": "指定股票代码列表 (例如: 600519,000001)，不传则默认处理全量"
      },
      "exchanges": {
        "flags": [
          "-x",
          "--exchanges"
        ],
        "type": "str.lower",
        "action": "store",
        "nargs": "+",
        "default": [
          "all"
        ],
        "choices": [
          "sh",
          "sz",
          "bj",
          "all"
        ],
        "required": false,
        "help": "指定交易所范围: sh (沪), sz (深), bj (北), all (默认全部)"
      },
      "source": {
        "flags": [
          "-s",
          "--source"
        ],
        "type": "str",
        "action": "store",
        "nargs": null,
        "default": "bstock",
        "choices": [
          "bstock"
        ],
        "required": false,
        "help": "指定数据源类型: bstock数据源, (默认 bstock数据源)"
      }
    }
  },

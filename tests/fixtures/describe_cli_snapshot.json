          "-c",
          "--codes"
        ],
        "type": null,
        "action": "store",
        "nargs": "+",
        "default": null,
        "choices": null,
        "required": false,
        "help": "指定股票代码列表 (例如: 600519 000001)，不传则默认处理全量"
      },
      "exchanges": {
        "flags": [
          "-x",
          "--exchanges"
        ],
        "type": "str.lower",
        "action": "store",
        "nargs": "+",

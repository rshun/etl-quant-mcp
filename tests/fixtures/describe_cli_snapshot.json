          "all"
        ],
        "choices": [
          "sh",
          "sz",
          "bj",
          "all"
        ],
        "required": false,
        "help": "指定交易所范围: sh (沪), sz (深), bj (北), all (默认全部)"
      },
      "forcerun": {
        "flags": [
          "-f",
          "--forcerun"
        ],
        "type": null,
        "action": "store_true",
        "nargs": 0,
        "default": false,
        "choices": null,
        "required": false,
        "help": "强制运行, 即使当前日期不是交易日"
      }
    }

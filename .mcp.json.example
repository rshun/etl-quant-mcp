{
  "mcpServers": {
    "quant-etl": {
      "command": "/absolute/path/to/etl-quant-mcp-venv/bin/etl-quant-mcp",
      "args": [],
      "env": {
        "SPRING_HOME": "/absolute/path/to/spring-home",
        "SPRING_BIN_DIR": "/absolute/path/to/spring-env/bin",
        "STALL_TIMEOUT_DEFAULT": "",
        "MAX_RUNTIME_DEFAULT": "7200",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}
